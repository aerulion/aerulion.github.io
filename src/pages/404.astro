---
import Layout from '../layouts/Layout.astro';
import ScreenFrame from '../components/ScreenFrame.astro';
import LatticeField from '../components/LatticeField.astro';
import PageTransition from '../components/PageTransition.astro';
import LogoMark from '../components/LogoMark.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
---

<Layout title="404 - Page Not Found" description="This page does not exist." noindex>
    <ScreenFrame/>
    <LatticeField/>
    <main class="not-found-section">
        <div class="not-found-card panel-cut">
            <div class="not-found-rail">
                <p class="mono-label">aerulion / Route error</p>
                <p class="mono-label">Status / 404</p>
            </div>

            <div class="not-found-body">
                <div class="not-found-logo" data-draw>
                    <LogoMark drawDelay={200} fillDelay={1100}/>
                </div>
                <div class="not-found-copy">
                    <h1>404</h1>
                    <h2>Page not found</h2>
                    <p>The page you're looking for doesn't exist or is no longer part of the current structure.</p>
                    <Button href="/" variant="solid">Return to home</Button>
                </div>
            </div>

            <div class="not-found-rail not-found-rail-bottom">
                <p class="mono-label">Node / 001</p>
                <p class="mono-label">Route / Unresolved</p>
            </div>
        </div>
    </main>
    <Footer/>
    <PageTransition/>
</Layout>

<style>
    .not-found-section {
        position: relative;
        z-index: 1;
        display: grid;
        place-items: center;
        min-height: 100svh;
        padding: clamp(1rem, 3vw, 2rem);
    }

    .not-found-card {
        width: min(100%, 780px);
        padding: clamp(1.5rem, 4vw, 3rem);
        display: grid;
        gap: clamp(2rem, 5vw, 3.5rem);
    }

    .not-found-rail {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--spacing-md);
        padding-bottom: var(--spacing-md);
        border-bottom: var(--hairline) solid var(--white);
    }

    .not-found-rail-bottom {
        padding: var(--spacing-md) 0 0;
        border-bottom: 0;
        border-top: var(--hairline) solid var(--white);
    }

    .not-found-body {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        align-items: center;
        gap: clamp(1.5rem, 4vw, 3rem);
    }

    .not-found-logo {
        width: clamp(72px, 12vw, 120px);
    }

    .not-found-copy {
        display: grid;
        gap: var(--spacing-md);
        justify-items: start;
    }

    .not-found-copy h1 {
        font-family: var(--font-family-display), sans-serif;
        font-size: clamp(3.5rem, 11vw, 7rem);
        line-height: 0.86;
        letter-spacing: 0.02em;
    }

    .not-found-copy h2 {
        font-family: var(--font-family-display), sans-serif;
        font-size: clamp(1.25rem, 3vw, var(--font-size-2xl));
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    .not-found-copy p {
        max-width: 46ch;
    }

    @media (max-width: 560px) {
        .not-found-body {
            grid-template-columns: 1fr;
        }

        .not-found-rail-bottom {
            display: none;
        }
    }
</style>
