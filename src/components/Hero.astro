---
import {skills} from '../data/skills';
import Button from './Button.astro';
import MorphingMark from './MorphingMark.astro';
import LineConstruct from './LineConstruct.astro';

const TICKS = 12;
const TICK_PERIOD = 2.8;
---

<header class="hero-section" data-station="00 / 06">
    <div class="container">
        <div class="hero-shell panel-cut">
            <div class="hero-rail hero-rail-top">
                <p class="mono-label">Java / Systems / Plugin architecture</p>
                <div class="hero-ticks" aria-hidden="true" style={`--tick-period:${TICK_PERIOD}s`}>
                    {
                        Array.from({length: TICKS}, (_, i) => (
                            <span style={`--tick-delay:${((-i * TICK_PERIOD) / TICKS).toFixed(3)}s`} />
                        ))
                    }
                </div>
                <p class="mono-label rail-end">Germany / EU Central / Online</p>
            </div>

            <div class="hero-content">
                <div class="hero-stage">
                    <div class="logo-construct" data-draw>
                        <div class="stage-construct">
                            <LineConstruct />
                        </div>
                        <div class="stage-mark">
                            <MorphingMark drawDelay={520} fillDelay={1500} shells={2} depth={0.4} ladder={0} />
                        </div>
                        <span class="construct-label construct-label-a">Core / Aerulion</span>
                        <span class="construct-label construct-label-b">Lattice / 30° / 60°</span>
                    </div>
                </div>

                <div class="hero-copy">
                    <p class="hero-kicker mono-label">Professional Java developer / Minecraft system design</p>
                    <h1 class="hero-title">aerulion</h1>
                    <p class="hero-subtitle">
                        Professional Java development for custom Minecraft systems, performance-focused plugins and
                        long-term server architecture.
                    </p>
                    <div class="hero-meta-grid" aria-hidden="true">
                        <span>Java runtime</span>
                        <span>Systems design</span>
                        <span>Gameplay logic</span>
                        <span>Data layer</span>
                    </div>
                    <div class="hero-actions">
                        <Button href="#work" glyph="descend">Selected work</Button>
                        <Button href="#context" glyph="descend">Context</Button>
                    </div>
                </div>
            </div>

            <div class="hero-rail hero-rail-bottom">
                <div class="hero-index" aria-hidden="true">
                    <span>Node / 001</span>
                    <span>Status / Active</span>
                </div>
                <div class="hero-index rail-end" aria-hidden="true">
                    <span>Developing since / 2012</span>
                    <span>Selected work / below</span>
                </div>
            </div>

            <ul class="skill-strip" role="list" aria-label="Core specialties">
                {
                    skills.map((skill, index) => (
                        <li class="skill-chip">
                            <span class="skill-index">{String(index + 1).padStart(2, '0')}</span>
                            <span class="skill-name">{skill}</span>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
</header>

<style>
    .hero-section {
        position: relative;
        z-index: var(--layer-page);
        padding: var(--flow-xl) 0 var(--spacing-4xl);
    }

    .hero-shell {
        display: flex;
        flex-direction: column;
        min-height: min(calc(100svh - clamp(2rem, 4vw, 4rem)), 980px);
        padding: var(--flow-xl) var(--plate-gutter) var(--plate-gutter);
        overflow: hidden;
    }

    /* ---- Rails ---- */

    .hero-rail {
        position: relative;
        z-index: var(--layer-raised);
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: var(--spacing-lg);
    }

    .hero-rail-top {
        align-items: center;
        padding-bottom: var(--flow-2xl);
    }

    .hero-rail-bottom {
        padding: var(--flow-xl) 0 var(--flow-lg);
        margin-top: auto;
    }

    .rail-end {
        text-align: right;
    }

    .hero-index {
        display: grid;
        gap: var(--spacing-3xs);
        font-family: var(--font-family-mono), monospace;
        font-size: var(--label-size);
        letter-spacing: var(--label-tracking);
        text-transform: uppercase;
    }

    .hero-ticks {
        display: flex;
        align-items: center;
        gap: var(--spacing-3xs);
        height: 2.4rem;
        flex-shrink: 0;
    }

    .hero-ticks span {
        display: block;
        width: var(--hairline);
        height: 100%;
        background: var(--white);
        transform-origin: center;
        animation: tickWave var(--tick-period) ease-in-out infinite var(--tick-delay, 0s);
    }

    .hero-ticks span:nth-child(3n) {
        height: 66%;
    }

    .hero-ticks span:nth-child(4n) {
        height: 40%;
    }

    @keyframes tickWave {
        0%,
        100% {
            transform: scaleY(0.28);
        }
        50% {
            transform: scaleY(1);
        }
    }

    /* ---- Main split ---- */

    .hero-content {
        position: relative;
        z-index: var(--layer-page);
        flex: 1;
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(min(100%, 26rem), 0.92fr);
        gap: var(--flow-3xl);
        align-items: center;
    }

    .hero-stage {
        min-width: 0;
        display: grid;
        place-items: center;
    }

    /* Square: scaffolding and mark share one coordinate space. */
    .logo-construct {
        position: relative;
        width: 100%;
        max-width: min(46vh, 520px);
        aspect-ratio: 1;
        display: grid;
        place-items: center;
    }

    /* Wrappers carry this component's scope id; a class on a child would not. */
    .stage-construct {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
    }

    .stage-mark {
        position: relative;
        width: 46%;
    }

    .construct-label {
        position: absolute;
        font-family: var(--font-family-mono), monospace;
        font-size: var(--label-size);
        letter-spacing: 0.14em;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .construct-label-a {
        top: -2%;
        right: -2%;
    }

    .construct-label-b {
        bottom: -2%;
        left: -2%;
    }

    /* ---- Copy ---- */

    .hero-copy {
        display: grid;
        gap: var(--spacing-lg);
        align-content: center;
        min-width: 0;
    }

    .hero-title {
        font-family: var(--font-family-accent), sans-serif;
        font-size: clamp(2.75rem, 5vw, 6.5rem);
        font-weight: 700;
        line-height: 0.9;
        letter-spacing: -0.01em;
    }

    .hero-subtitle {
        font-size: clamp(1rem, 1.3vw, var(--font-size-xl));
        max-width: 42ch;
    }

    .hero-meta-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--spacing-xs);
        padding-top: var(--spacing-xs);
        border-top: var(--hairline) solid var(--white);
        font-family: var(--font-family-mono), monospace;
        font-size: var(--label-size);
        letter-spacing: 0.14em;
        text-transform: uppercase;
    }

    .hero-meta-grid span {
        padding: var(--spacing-xs) var(--spacing-xs);
        border: var(--hairline) solid var(--white);
    }

    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: var(--spacing-sm);
    }

    /* ---- Skill strip ---- */

    .skill-strip {
        position: relative;
        z-index: var(--layer-raised);
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: var(--spacing-sm);
        list-style: none;
    }

    .skill-chip {
        min-height: 4.5rem;
        display: grid;
        align-content: end;
        gap: var(--spacing-2xs);
        padding: var(--spacing-sm) var(--spacing-md);
        border: var(--hairline) solid var(--white);
    }

    .skill-index {
        font-family: var(--font-family-mono), monospace;
        font-size: var(--font-size-xs);
        letter-spacing: 0.14em;
    }

    .skill-name {
        font-size: var(--font-size-sm);
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    @media (max-width: 1100px) {
        .hero-shell {
            min-height: 0;
        }

        .hero-content {
            grid-template-columns: 1fr;
            gap: var(--spacing-2xl);
            padding: var(--spacing-lg) 0;
        }

        .logo-construct {
            max-width: min(62vw, 360px);
        }

        .hero-copy {
            justify-items: start;
        }
    }

    @media (max-width: 768px) {
        .hero-rail-top .mono-label,
        .hero-ticks {
            display: none;
        }

        .hero-rail-top {
            padding-bottom: var(--spacing-md);
        }

        .logo-construct {
            max-width: min(70vw, 290px);
        }

        .construct-label {
            display: none;
        }

        .hero-title {
            font-size: clamp(2.5rem, 13vw, 4.5rem);
        }

        .skill-strip {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .skill-chip {
            min-height: 3.75rem;
        }
    }

    @media (max-width: 560px) {
        .hero-rail-bottom {
            display: none;
        }

        .hero-actions {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
            justify-self: stretch;
        }
    }
</style>
