---
import {age} from '../utils/dates';
import {FIRST_YEAR} from '../data/timeline';

const facts = [
    {term: 'Role', value: 'Lead Developer'},
    {term: 'Base', value: `Germany / ${age}`},
    {term: 'Focus', value: 'Paper, Bukkit, Java, database architecture'},
    {term: 'Primary Client', value: 'Corpium'},
    {term: 'Developing Since', value: String(FIRST_YEAR)}
];
---

<section class="about-section" id="context" data-station="01 / 06">
    <div class="container">
        <div class="about-wrapper panel-cut" data-reveal>
            <div class="section-header">
                <div class="section-rail">
                    <p class="section-eyebrow">Context</p>
                    <span class="section-rule" aria-hidden="true"></span>
                    <p class="section-count" data-roll>01 / 06</p>
                </div>
                <h2 class="section-title">Precision under load.</h2>
                <div class="section-lede">
                    <p class="section-subtitle">
                        Custom Java architecture, gameplay systems and performant server-side tooling for projects that
                        need stability under real load.
                    </p>
                    <div class="section-line" aria-hidden="true"></div>
                </div>
            </div>

            <div class="about-content">
                <dl class="about-facts">
                    {
                        facts.map((fact) => (
                            <div class="fact-row">
                                <dt>{fact.term}</dt>
                                <dd>{fact.value}</dd>
                            </div>
                        ))
                    }
                </dl>

                <div class="about-text prose">
                    <p>
                        My name is aerulion, I'm a {age}-year-old <strong>Java developer from Germany</strong> with a focus
                        on building <strong>custom gameplay systems</strong> that push beyond default Minecraft constraints
                        while staying coherent and maintainable.
                    </p>
                    <p>
                        As the <strong>lead developer</strong> at <a
                            href="https://corpium.net/"
                            class="modern-link"
                            rel="noopener noreferrer"
                            target="_blank">Corpium</a
                        >, one of the oldest German Minecraft servers, I design and maintain sophisticated <strong
                            >plugin ecosystems</strong
                        > with performance-focused features, complex mechanics and a controlled vanilla-adjacent feel.
                    </p>
                    <p>
                        My expertise ranges from low-level Java optimization to high-level system design, with
                        particular strengths in <strong>database architecture</strong> and <strong
                            >scalable plugin development</strong
                        >. Clean abstractions, longevity and operational clarity are core to the way I build.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .about-section {
        padding-bottom: var(--spacing-5xl);
    }

    .about-wrapper {
        padding: var(--flow-3xl);
    }

    .about-content {
        display: grid;
        grid-template-columns: minmax(220px, 0.8fr) minmax(0, 1.2fr);
        gap: var(--flow-3xl);
        align-items: start;
    }

    .about-facts {
        display: grid;
        padding-top: var(--spacing-3xs);
        border-top: var(--hairline) solid var(--white);
    }

    .fact-row {
        display: grid;
        gap: var(--spacing-3xs);
        padding: var(--spacing-md) 0;
        border-bottom: var(--hairline) solid var(--white);
    }

    .fact-row dt {
        font-family: var(--font-family-mono), monospace;
        font-size: var(--label-size);
        text-transform: uppercase;
        letter-spacing: var(--label-tracking);
    }

    .fact-row dd {
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-size: var(--font-size-sm);
    }

    .about-text {
        display: grid;
        gap: var(--spacing-lg);
    }

    .about-text p {
        font-size: clamp(1rem, 1.25vw, var(--font-size-lg));
        line-height: 1.8;
        max-width: 68ch;
    }

    .about-text strong {
        font-weight: 600;
    }

    @media (max-width: 900px) {
        .about-content {
            grid-template-columns: 1fr;
            gap: var(--spacing-2xl);
        }
    }

    @media (max-width: 560px) {
        .about-wrapper {
            padding: var(--spacing-xl) var(--spacing-lg);
        }
    }
</style>
