---
import {age} from '../utils/dates';

const facts = [
    {term: 'Role', value: 'Lead Developer'},
    {term: 'Base', value: `Germany / ${age}`},
    {term: 'Focus', value: 'Paper, Bukkit, Java, database architecture'},
    {term: 'Primary Client', value: 'Corpium'},
    {term: 'Active Since', value: '2014'}
];
---

<section class="about-section" id="context">
    <div class="container">
        <div class="about-wrapper panel-cut" data-reveal>
            <div class="section-header">
                <div class="section-rail">
                    <p class="section-eyebrow">Context</p>
                    <span class="section-rule" aria-hidden="true"></span>
                    <p class="section-count">01 / 03</p>
                </div>
                <h2 class="section-title">Precision under load.</h2>
                <div class="section-lede">
                    <p class="section-subtitle">
                        Custom Java architecture, gameplay systems and performant server-side tooling for projects
                        that need stability under real load.
                    </p>
                    <div class="section-line" aria-hidden="true"></div>
                </div>
            </div>

            <div class="about-content">
                <dl class="about-facts">
                    {facts.map((fact) => (
                            <div class="fact-row">
                                <dt>{fact.term}</dt>
                                <dd>{fact.value}</dd>
                            </div>
                    ))}
                </dl>

                <div class="about-text">
                    <p>
                        My name is aerulion, I'm a {age}-year-old <strong>Java developer from Germany</strong> with a
                        focus on building <strong>custom gameplay systems</strong> that push beyond default Minecraft
                        constraints while staying coherent and maintainable.
                    </p>
                    <p>
                        As the <strong>lead developer</strong> at <a
                            href="https://corpium.net/"
                            class="modern-link"
                            rel="noopener"
                            target="_blank"
                    >Corpium</a>, one of the oldest German Minecraft servers, I design and maintain sophisticated
                        <strong
                        >plugin ecosystems</strong> with performance-focused features, complex mechanics and a
                        controlled
                        vanilla-adjacent feel.
                    </p>
                    <p>
                        My expertise ranges from low-level Java optimization to high-level system design, with
                        particular strengths in <strong>database architecture</strong> and <strong>scalable plugin
                        development</strong>. Clean abstractions, longevity and operational clarity are core to the
                        way I build.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .about-section {
        padding: 0 0 var(--spacing-5xl);
    }

    .about-wrapper {
        padding: clamp(2rem, 4vw, 4rem);
    }

    .about-content {
        display: grid;
        grid-template-columns: minmax(220px, 0.8fr) minmax(0, 1.2fr);
        gap: clamp(2rem, 5vw, 5rem);
        align-items: start;
    }

    .about-facts {
        display: grid;
        padding-top: 0.2rem;
        border-top: var(--hairline) solid var(--white);
    }

    .fact-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 0.3rem;
        padding: 0.9rem 0;
        border-bottom: var(--hairline) solid var(--white);
    }

    .fact-row:last-child {
        border-bottom: var(--hairline) solid var(--white);
    }

    .fact-row dt {
        font-family: var(--font-family-mono), monospace;
        font-size: var(--label-size);
        text-transform: uppercase;
        letter-spacing: var(--label-tracking);
        color: var(--white);
    }

    .fact-row dd {
        color: var(--white);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-size: var(--font-size-sm);
    }

    .about-text {
        display: grid;
        gap: var(--spacing-lg);
    }

    .about-text p {
        font-size: clamp(1rem, 1.25vw, var(--font-size-lg));
        line-height: 1.8;
        color: var(--white);
        max-width: 68ch;
    }

    .about-text strong {
        color: var(--white);
        font-weight: 600;
    }

    @media (max-width: 900px) {
        .about-content {
            grid-template-columns: 1fr;
            gap: var(--spacing-2xl);
        }
    }

    @media (max-width: 480px) {
        .about-wrapper {
            padding: var(--spacing-xl) var(--spacing-lg);
        }
    }
</style>
