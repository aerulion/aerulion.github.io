---
interface Props {
    href: string;
    variant?: 'outline' | 'solid';
    glyph?: string;
}

const {href, variant = 'outline', glyph} = Astro.props;
const external = /^https?:/.test(href);
---

<a
        class:list={['btn', variant === 'solid' && 'btn-solid']}
        href={href}
        target={external ? '_blank' : undefined}
        rel={external ? 'noopener noreferrer' : undefined}
>
    <slot/>
    {glyph && <span class="btn-glyph" aria-hidden="true">{glyph}</span>}
</a>
