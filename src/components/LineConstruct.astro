---
interface Props {
    class?: string;
    axes?: boolean;
}

const {class: className = '', axes = true} = Astro.props;

type Pt = [number, number];

const HEX: Pt[] = [
    [94, 50],
    [72, 11.895],
    [28, 11.895],
    [6, 50],
    [28, 88.105],
    [72, 88.105]
];
const TRI_UP: Pt[] = [
    [50, 6],
    [88.105, 72],
    [11.895, 72]
];
const TRI_DOWN: Pt[] = [
    [50, 94],
    [11.895, 28],
    [88.105, 28]
];
const AXES: Pt[][] = [
    [
        [2, 50],
        [98, 50]
    ],
    [
        [26, 8.43],
        [74, 91.57]
    ],
    [
        [26, 91.57],
        [74, 8.43]
    ]
];

const closed = (pts: Pt[]) => `M ${pts.map((p) => p.join(' ')).join(' L ')} Z`;
const open = (pts: Pt[]) => `M ${pts.map((p) => p.join(' ')).join(' L ')}`;

const edgesOf = (pts: Pt[], close: boolean) => {
    const out: number[][] = [];
    for (let i = 0; i < pts.length - (close ? 0 : 1); i++) {
        const a = pts[i],
            b = pts[(i + 1) % pts.length];
        out.push([a[0], a[1], b[0], b[1]]);
    }
    return out;
};

const segments = [
    ...edgesOf(HEX, true),
    ...edgesOf(TRI_UP, true),
    ...edgesOf(TRI_DOWN, true),
    ...(axes ? AXES.flatMap((a) => edgesOf(a, false)) : [])
];
---

<svg
    class:list={['line-construct', className]}
    viewBox="0 0 100 100"
    aria-hidden="true"
    focusable="false"
    data-collide="lines"
    data-segments={JSON.stringify(segments)}
>
    {
        axes &&
            AXES.map((axis, i) => (
                <path
                    class="draw-path construct-axis"
                    d={open(axis)}
                    pathLength="1"
                    style={`--draw-delay:${i * 80}ms`}
                />
            ))
    }

    <path class="draw-path construct-hex" d={closed(HEX)} pathLength="1" style="--draw-delay:240ms"></path>
    <path class="draw-path construct-tri" d={closed(TRI_UP)} pathLength="1" style="--draw-delay:380ms"></path>
    <path class="draw-path construct-ghost" d={closed(TRI_DOWN)} pathLength="1" style="--draw-delay:500ms"></path>

    <path class="construct-tracer tracer-hex" d={closed(HEX)} pathLength="1"></path>
    <path class="construct-tracer tracer-tri" d={closed(TRI_UP)} pathLength="1"></path>
</svg>

<style>
    .line-construct {
        display: block;
        width: 100%;
        height: auto;
        overflow: visible;
    }

    .construct-axis {
        stroke-dasharray: 0.004 0.011;
    }

    .construct-ghost {
        stroke-dasharray: 0.009 0.016;
    }

    /* A dashed line cannot express a dashoffset draw, so these fade in. */
    :global(.js) .construct-axis,
    :global(.js) .construct-ghost {
        stroke-dashoffset: 0;
        opacity: 0;
        transition: opacity var(--dur-md) linear var(--draw-delay, 0ms);
    }

    :global(.is-drawn) .construct-axis,
    :global(.is-drawn) .construct-ghost {
        opacity: 1;
    }

    :global(html:not(.js)) .construct-axis,
    :global(html:not(.js)) .construct-ghost {
        opacity: 1;
    }

    .construct-tracer {
        fill: none;
        stroke: var(--white);
        stroke-width: 1;
        vector-effect: non-scaling-stroke;
        stroke-dasharray: 0.035 0.965;
        stroke-dashoffset: 0;
        opacity: 0;
    }

    :global(.is-drawn) .tracer-hex {
        opacity: 1;
        animation: traceLoop 14s linear infinite 1.2s;
    }

    :global(.is-drawn) .tracer-tri {
        opacity: 1;
        animation: traceLoop 19s linear infinite reverse 1.2s;
    }

    /* Both periods divide 0.15 exactly, so the crawl loops. */
    :global(.is-drawn) .construct-axis {
        animation: dashCrawl 34s linear infinite;
    }

    :global(.is-drawn) .construct-ghost {
        animation: dashCrawl 26s linear infinite;
    }

    @media (prefers-reduced-motion: reduce) {
        .construct-tracer {
            opacity: 0;
        }
    }
</style>
