---
/*
 * Scaffolding on the logo's own 30/60 lattice: a flat-top hexagon, the
 * triangle pair inscribing it, and three axes through the centre.
 * Coordinates come from a circumradius of 44 on a 100x100 box; the axes
 * stop at 48.
 *
 * Nothing rotates. A rotating figure is off the 30/60 grid for all but six
 * frames of its cycle, so the motion runs along the lines instead. Holding
 * the geometry still also lets it be handed to the lattice as fixed
 * segments to collide with.
 */

interface Props {
    class?: string;
    axes?: boolean;
}

const {class: className = '', axes = true} = Astro.props;

type Pt = [number, number];

// Flat-top hexagon: vertices at 0°, 60°, 120°, 180°, 240°, 300°.
const HEX: Pt[] = [[94, 50], [72, 11.895], [28, 11.895], [6, 50], [28, 88.105], [72, 88.105]];
// Apex-up equilateral triangle — the silhouette of the "A".
const TRI_UP: Pt[] = [[50, 6], [88.105, 72], [11.895, 72]];
// Apex-down counterpart; together they form a hexagram, all edges at 60°.
const TRI_DOWN: Pt[] = [[50, 94], [11.895, 28], [88.105, 28]];
// Hexagonal axes through the centre at 0°, 60° and 120°.
const AXES: Pt[][] = [
    [[2, 50], [98, 50]],
    [[26, 8.43], [74, 91.57]],
    [[26, 91.57], [74, 8.43]]
];

const closed = (pts: Pt[]) => `M ${pts.map((p) => p.join(' ')).join(' L ')} Z`;
const open = (pts: Pt[]) => `M ${pts.map((p) => p.join(' ')).join(' L ')}`;

// Flat segment list, in viewBox units, for the lattice to collide with.
const edgesOf = (pts: Pt[], close: boolean) => {
    const out: number[][] = [];
    for (let i = 0; i < pts.length - (close ? 0 : 1); i++) {
        const a = pts[i], b = pts[(i + 1) % pts.length];
        out.push([a[0], a[1], b[0], b[1]]);
    }
    return out;
};

const segments = [
    ...edgesOf(HEX, true),
    ...edgesOf(TRI_UP, true),
    ...edgesOf(TRI_DOWN, true),
    ...(axes ? AXES.flatMap((a) => edgesOf(a, false)) : [])
];
---

<svg
        class:list={['line-construct', className]}
        viewBox="0 0 100 100"
        aria-hidden="true"
        focusable="false"
        data-collide="lines"
        data-segments={JSON.stringify(segments)}
>
    {axes && AXES.map((axis, i) => (
            <path class="draw-path construct-axis" d={open(axis)} pathLength="1"
                  style={`--draw-delay:${i * 80}ms`}/>
    ))}

    <path class="draw-path construct-hex" d={closed(HEX)} pathLength="1" style="--draw-delay:240ms"/>
    <path class="draw-path construct-tri" d={closed(TRI_UP)} pathLength="1" style="--draw-delay:380ms"/>
    <path class="draw-path construct-ghost" d={closed(TRI_DOWN)} pathLength="1" style="--draw-delay:500ms"/>

    <path class="construct-tracer tracer-hex" d={closed(HEX)} pathLength="1"/>
    <path class="construct-tracer tracer-tri" d={closed(TRI_UP)} pathLength="1"/>
</svg>

<style>
    .line-construct {
        display: block;
        width: 100%;
        height: auto;
        overflow: visible;
    }

    /* Hierarchy comes from density, not opacity: every pixel stays pure
       white or pure black. */
    .construct-axis {
        stroke-dasharray: 0.004 0.011;
    }

    .construct-ghost {
        stroke-dasharray: 0.009 0.016;
    }

    /* A dashed line cannot express a dashoffset draw, so these fade in. */
    :global(.js) .construct-axis,
    :global(.js) .construct-ghost {
        stroke-dashoffset: 0;
        opacity: 0;
        transition: opacity 0.6s linear var(--draw-delay, 0ms);
    }

    :global(.is-drawn) .construct-axis,
    :global(.is-drawn) .construct-ghost {
        opacity: 1;
    }

    :global(html:not(.js)) .construct-axis,
    :global(html:not(.js)) .construct-ghost {
        opacity: 1;
    }

    /* A short dash orbiting the figure, along the geometry rather than
       through it. */
    .construct-tracer {
        fill: none;
        stroke: var(--white);
        stroke-width: 1;
        vector-effect: non-scaling-stroke;
        stroke-dasharray: 0.035 0.965;
        stroke-dashoffset: 0;
        opacity: 0;
    }

    :global(.is-drawn) .tracer-hex {
        opacity: 1;
        animation: traceLoop 14s linear infinite 1.2s;
    }

    :global(.is-drawn) .tracer-tri {
        opacity: 1;
        animation: traceLoop 19s linear infinite reverse 1.2s;
    }

    /* Both periods divide 0.15 exactly so the crawl loops seamlessly. */
    :global(.is-drawn) .construct-axis {
        animation: dashCrawl 34s linear infinite;
    }

    :global(.is-drawn) .construct-ghost {
        animation: dashCrawl 26s linear infinite;
    }

    @media (prefers-reduced-motion: reduce) {
        .construct-tracer {
            opacity: 0;
        }
    }
</style>
