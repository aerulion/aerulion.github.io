---
import ProjectCard from './ProjectCard.astro';
import {projects} from '../data/projects';
---

<section class="projects-section" id="work" data-station="03 / 06">
    <div class="container">
        <div class="section-header" data-reveal>
            <div class="section-rail">
                <p class="section-eyebrow">Selected systems</p>
                <span class="section-rule" aria-hidden="true"></span>
                <p class="section-count" data-roll>03 / 06</p>
            </div>
            <h2 class="section-title">Two systems, end to end.</h2>
            <div class="section-lede">
                <p class="section-subtitle">
                    Large-scale builds shaped around progression, storage and control — designed for live gameplay, long
                    sessions and server-side reliability.
                </p>
                <div class="section-line" aria-hidden="true"></div>
            </div>
        </div>

        <div class="projects-grid">
            {projects.map((project, index) => <ProjectCard project={project} position={index + 1} />)}
        </div>
    </div>
</section>

<style>
    .projects-section {
        padding-bottom: var(--spacing-5xl);
    }

    .projects-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 30rem), 1fr));
        grid-template-rows: auto auto auto 1fr auto;
        gap: var(--spacing-xl);
    }
</style>
