---
/* The lines are the layout: pure white hairlines, no texture or fades. */
---

<div class="structure" aria-hidden="true">
    <span class="rule rule-left"></span>
    <span class="rule rule-right"></span>
    <span class="rule rule-top"></span>
</div>

<style>
    .structure {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 0;
    }

    .rule {
        position: absolute;
        background: var(--white);
    }

    .rule-left,
    .rule-right {
        top: 0;
        bottom: 0;
        width: var(--hairline);
    }

    .rule-left {
        left: clamp(0.5rem, 1vw, 1.15rem);
    }

    .rule-right {
        right: clamp(0.5rem, 1vw, 1.15rem);
    }

    .rule-top {
        left: 0;
        right: 0;
        top: clamp(0.5rem, 1vw, 1.15rem);
        height: var(--hairline);
    }

    @media (max-width: 768px) {
        .rule-left,
        .rule-right {
            display: none;
        }
    }
</style>
