---
import {uid} from '../utils/uid';

interface Props {
    class?: string;
    drawDelay?: number;
    fillDelay?: number;
}

const {class: className = '', drawDelay = 0, fillDelay = 900} = Astro.props;

const SILHOUETTE = "m24.686 19.8438-3.1349 1.81-3.3773-5.8496-4.9444 2.8546-1.8102-1.0449 1.81-3.1348 3.1347-1.8098-3.1347-5.4297-6.512 11.2793 6.512 3.7597 3.3773-1.95 1.81 3.135-5.1873 2.9947-11.4568-6.6145L13.2292 0Z";

const clipId = uid('logo-clip');

const VIEW = 26.458333;
const TAN_30 = 0.5773502692;
const MARGIN = 0.25;
const INK_REST = 7.638 - MARGIN;
const INK_TRAVEL = VIEW + 2 * MARGIN;

const FAR = 60;
const INK = [
    [-FAR, INK_REST + FAR * TAN_30],
    [FAR, INK_REST - FAR * TAN_30],
    [FAR, FAR * 1.5],
    [-FAR, FAR * 1.5]
].map((point) => point.map((n) => Number(n.toFixed(4))).join(',')).join(' ');
---

<svg
        class:list={['logo-mark', className]}
        viewBox="0 0 26.458333 26.458333"
        role="img"
        aria-label="aerulion logo"
        data-collide="logo"
        style={`--draw-delay:${drawDelay}ms; --fill-delay:${fillDelay}ms; --ink-travel:${INK_TRAVEL}px;`}
>
    <defs>
        <clipPath id={clipId}>
            <path d={SILHOUETTE}/>
        </clipPath>
    </defs>

    <path class="draw-path logo-outline" d={SILHOUETTE} pathLength="1"/>

    <g clip-path={`url(#${clipId})`}>
        <polygon class="logo-ink" points={INK}/>
    </g>
</svg>

<style>
    .logo-mark {
        display: block;
        width: 100%;
        height: auto;
        overflow: visible;
    }

    .logo-outline {
        stroke-width: 0.4;
    }

    .logo-ink {
        fill: var(--white);
        transform: translateY(var(--ink-travel));
    }

    :global(.js) .logo-ink {
        transition: transform 0.9s var(--ease-draw) var(--fill-delay, 900ms);
    }

    :global(.is-drawn) .logo-ink,
    :global(html:not(.js)) .logo-ink {
        transform: translateY(0);
    }

    /* Half the stroke sits outside the silhouette, so it goes once inked. */
    :global(.js) .logo-outline {
        transition: stroke-dashoffset 1.15s var(--ease-draw) var(--draw-delay, 0ms),
        stroke-opacity 0.45s linear calc(var(--fill-delay, 900ms) + 700ms);
    }

    :global(.is-drawn) .logo-outline {
        stroke-opacity: 0;
    }

    @media (prefers-reduced-motion: reduce) {
        .logo-ink {
            transform: translateY(0);
        }

        .logo-outline {
            stroke-opacity: 0;
        }
    }
</style>
