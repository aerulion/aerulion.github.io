---

---

<div class="frame" aria-hidden="true">
    <span class="rule rule-top"></span>
    <span class="rule rule-bottom"></span>
    <span class="rule rule-left"></span>
    <span class="rule rule-right"></span>

    <div class="gauge" data-gauge>
        <p class="gauge-readout mono-label" data-gauge-readout>00 / 05</p>
        <span class="gauge-tick"></span>
    </div>
</div>

<style>
    .frame {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 0;
    }

    .rule {
        position: absolute;
        background: var(--white);
    }

    .rule-top,
    .rule-bottom {
        left: 0;
        right: 0;
        height: var(--hairline);
    }

    .rule-left,
    .rule-right {
        top: 0;
        bottom: 0;
        width: var(--hairline);
    }

    .rule-top {
        top: var(--frame-inset);
    }

    .rule-bottom {
        bottom: var(--frame-inset);
    }

    .rule-left {
        left: var(--frame-inset);
    }

    .rule-right {
        right: var(--frame-inset);
    }

    .gauge {
        --gauge-inset: clamp(3rem, 7vh, 5rem);

        position: absolute;
        top: calc(var(--frame-inset) + var(--gauge-inset));
        bottom: calc(var(--frame-inset) + var(--gauge-inset));
        right: var(--frame-inset);
        width: 0;
        opacity: 0;
    }

    .gauge[data-live='true'] {
        opacity: 1;
    }

    .gauge-tick {
        position: absolute;
        top: calc(var(--tick, 0) * 100%);
        right: 0;
        width: 17px;
        height: var(--hairline);
        background: var(--white);
        transform: translate(8px, -50%);
    }

    .gauge-readout {
        position: absolute;
        top: calc(var(--tick, 0) * 100%);
        right: 24px;
        transform: translateY(-50%);
        white-space: nowrap;
        color: var(--white);
    }

    @media (max-width: 1799px) {
        .gauge-readout {
            display: none;
        }
    }

    @media (max-width: 640px) {
        .gauge {
            display: none;
        }
    }
</style>
