---
interface Endpoint {
    label: string;
    value: string;
    note: string;
    href?: string;
}

const endpoints: Endpoint[] = [
    {
        label: 'GitHub',
        value: 'github.com/aerulion',
        note: 'Source, experiments and public work',
        href: 'https://github.com/aerulion'
    },
    {
        label: 'Corpium',
        value: 'corpium.net',
        note: 'The server these systems run on',
        href: 'https://corpium.net/'
    },
    {
        label: 'Email',
        value: 'info@aerulion.net',
        note: 'The direct line for work enquiries',
        href: 'mailto:info@aerulion.net'
    },
    {
        label: 'Discord',
        value: 'aerulion',
        note: 'Same handle as everywhere else'
    }
];
---

<section class="contact-section" id="endpoints">
    <div class="container">
        <div class="section-header" data-reveal>
            <div class="section-rail">
                <p class="section-eyebrow">Endpoints</p>
                <span class="section-rule" aria-hidden="true"></span>
                <p class="section-count">05 / 05</p>
            </div>
            <h2 class="section-title">Where to find me.</h2>
            <div class="section-lede">
                <p class="section-subtitle">
                    Public work in one place, private work in another, and two ways to reach me directly.
                </p>
                <div class="section-line" aria-hidden="true"></div>
            </div>
        </div>

        <ul class="endpoint-list" role="list" data-reveal>
            {
                endpoints.map((endpoint, index) => {
                    const position = String(index + 1).padStart(2, '0');
                    const external = endpoint.href?.startsWith('http');

                    return (
                        <li class="endpoint">
                            {endpoint.href ? (
                                <a
                                    href={endpoint.href}
                                    class="endpoint-link"
                                    target={external ? '_blank' : undefined}
                                    rel={external ? 'noopener noreferrer' : undefined}
                                >
                                    <span class="endpoint-index">{position}</span>
                                    <span class="endpoint-body">
                                        <span class="endpoint-label">{endpoint.label}</span>
                                        <span class="endpoint-value">{endpoint.value}</span>
                                    </span>
                                    <span class="endpoint-note">{endpoint.note}</span>
                                    <span class="endpoint-glyph" aria-hidden="true">
                                        ↗
                                    </span>
                                </a>
                            ) : (
                                <button
                                    type="button"
                                    class="endpoint-link"
                                    data-copy={endpoint.value}
                                    aria-label={`Copy ${endpoint.label} handle ${endpoint.value}`}
                                >
                                    <span class="endpoint-index">{position}</span>
                                    <span class="endpoint-body">
                                        <span class="endpoint-label">{endpoint.label}</span>
                                        <span class="endpoint-value">{endpoint.value}</span>
                                    </span>
                                    <span class="endpoint-note" data-copy-note aria-live="polite">
                                        {endpoint.note}
                                    </span>
                                    <span class="endpoint-glyph" aria-hidden="true">
                                        ⧉
                                    </span>
                                </button>
                            )}
                        </li>
                    );
                })
            }
        </ul>
    </div>
</section>

<style>
    .endpoint-list {
        list-style: none;
        border-top: var(--hairline) solid var(--white);
    }

    .endpoint {
        border-bottom: var(--hairline) solid var(--white);
    }

    /* Shared by the anchor and the copy button. */
    .endpoint-link {
        width: 100%;
        display: grid;
        grid-template-columns: auto minmax(0, 0.9fr) minmax(0, 1.1fr) auto;
        align-items: center;
        gap: clamp(1rem, 3vw, 3rem);
        padding: clamp(1.4rem, 2.5vw, 2rem) clamp(0.5rem, 1.5vw, 1.25rem);
        border: 0;
        background: transparent;
        font: inherit;
        text-align: left;
        text-decoration: none;
        color: inherit;
        cursor: pointer;
        transition:
            background var(--transition-base),
            padding-left var(--transition-base);
    }

    /* Children inherit colour, or they would vanish against the white. */
    .endpoint-link:hover,
    .endpoint-link:focus-visible {
        background: var(--white);
        color: var(--black);
        padding-left: clamp(1rem, 2.5vw, 2rem);
    }

    .endpoint-index {
        font-family: var(--font-family-mono), monospace;
        font-size: var(--label-size);
        letter-spacing: 0.16em;
    }

    .endpoint-body {
        display: grid;
        gap: 0.3rem;
        min-width: 0;
    }

    .endpoint-label {
        font-family: var(--font-family-display), sans-serif;
        font-size: clamp(1.4rem, 2.4vw, 2rem);
        font-weight: 600;
        line-height: 1;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .endpoint-value {
        font-family: var(--font-family-mono), monospace;
        font-size: var(--label-size);
        letter-spacing: 0.12em;
    }

    .endpoint-note {
        font-size: var(--font-size-sm);
    }

    .endpoint-glyph {
        font-size: var(--font-size-xl);
        transition: transform var(--transition-base);
    }

    a.endpoint-link:hover .endpoint-glyph,
    a.endpoint-link:focus-visible .endpoint-glyph {
        transform: translate3d(0.25rem, -0.25rem, 0);
    }

    button.endpoint-link:hover .endpoint-glyph,
    button.endpoint-link:focus-visible .endpoint-glyph {
        transform: translate3d(0, 0.15rem, 0);
    }

    @media (max-width: 768px) {
        .endpoint-link {
            grid-template-columns: auto minmax(0, 1fr) auto;
            gap: var(--spacing-md);
        }

        .endpoint-glyph {
            grid-column: 3;
            grid-row: 1;
        }

        .endpoint-note {
            grid-column: 2 / -1;
        }
    }
</style>

<script>
    import {mountCopyEndpoints} from '../scripts/copy-endpoint';

    mountCopyEndpoints();
</script>
