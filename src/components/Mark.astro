---
import {uid} from '../utils/uid';
import {inkPoints, INK_TRAVEL, SILHOUETTE, VIEW} from '../scripts/mark-geometry';

interface Props {
    class?: string;
    drawDelay?: number;
    fillDelay?: number;
}

const {class: className = '', drawDelay = 0, fillDelay = 900} = Astro.props;

const clipId = uid('logo-clip');

const INK = inkPoints();
---

<svg
    class:list={['logo-mark', className]}
    viewBox={`0 0 ${VIEW} ${VIEW}`}
    role="img"
    aria-label="aerulion logo"
    data-collide="mark"
    style={`--draw-delay:${drawDelay}ms; --fill-delay:${fillDelay}ms; --ink-travel:${INK_TRAVEL}px;`}
>
    <defs>
        <clipPath id={clipId}>
            <path d={SILHOUETTE}></path>
        </clipPath>
    </defs>

    <g clip-path={`url(#${clipId})`}>
        <path class="draw-path logo-outline" d={SILHOUETTE} pathLength="1"></path>
    </g>

    <g clip-path={`url(#${clipId})`}>
        <polygon class="logo-ink" points={INK}></polygon>
    </g>
</svg>

<style>
    .logo-mark {
        display: block;
        width: 100%;
        height: auto;
        overflow: visible;
    }

    .logo-outline {
        stroke-width: 0.8;
    }

    .logo-ink {
        fill: var(--white);
        transform: translateY(var(--ink-travel));
    }

    :global(.js) .logo-ink {
        transition: transform var(--dur-lg) var(--ease-draw) var(--fill-delay, 900ms);
    }

    :global(.is-drawn) .logo-ink,
    :global(html:not(.js)) .logo-ink {
        transform: translateY(0);
    }

    /* Clipped to the silhouette, so the ink arrives flush with the stroke rather than
       a half-stroke inside it. It goes once inked either way. */
    :global(.js) .logo-outline {
        transition:
            stroke-dashoffset var(--dur-xl) var(--ease-draw) var(--draw-delay, 0ms),
            stroke-opacity var(--dur-sm) linear calc(var(--fill-delay, 900ms) + 700ms);
    }

    :global(.is-drawn) .logo-outline {
        stroke-opacity: 0;
    }

    @media (prefers-reduced-motion: reduce) {
        .logo-ink {
            transform: translateY(0);
        }

        .logo-outline {
            stroke-opacity: 0;
        }
    }
</style>
