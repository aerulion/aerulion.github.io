<canvas class="lattice-field" aria-hidden="true"></canvas>

<style>
    .lattice-field {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        pointer-events: none;
        display: block;
    }
</style>

<script>
    import {mountLatticeField} from '../scripts/lattice-field';

    const canvas = document.querySelector<HTMLCanvasElement>('.lattice-field');
    const wanted = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (canvas && wanted) mountLatticeField(canvas);
</script>
