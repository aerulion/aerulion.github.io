---
import LineConstruct from './LineConstruct.astro';
---

<div class="curtain" data-curtain aria-hidden="true">
    <div class="curtain-figure">
        <LineConstruct class="curtain-construct" />
    </div>
    <p class="curtain-label mono-label" data-curtain-label>Routing</p>
</div>

<style>
    .curtain {
        position: fixed;
        inset: 0;
        z-index: var(--layer-curtain);
        display: grid;
        place-items: center;
        background: var(--black);
        pointer-events: none;
        opacity: 0;
        visibility: hidden;
    }

    .curtain[data-state='active'] {
        opacity: 1;
        visibility: visible;
        pointer-events: all;
    }

    .curtain[data-state='lifting'] {
        opacity: 1;
        visibility: visible;
        animation: curtainLift var(--dur-md) var(--ease-settle) forwards;
    }

    @keyframes curtainLift {
        from {
            clip-path: polygon(0 0, 100% calc(0% - 57.735vw), 100% 100%, 0 100%);
        }
        to {
            clip-path: polygon(0 calc(100% + 57.735vw), 100% 100%, 100% 100%, 0 100%);
        }
    }

    .curtain-figure {
        width: min(38vmin, 300px);
    }

    .curtain-label {
        position: absolute;
        bottom: clamp(var(--spacing-lg), 4vw, var(--spacing-2xl));
        left: 50%;
        transform: translateX(-50%);
    }
</style>

<script>
    import {mountCurtain} from '../scripts/curtain';

    const curtain = document.querySelector<HTMLElement>('[data-curtain]');
    if (curtain) mountCurtain(curtain);
</script>
