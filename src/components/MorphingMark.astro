---
import {uid} from '../utils/uid';
import {barePath, inkPoints, INK_TRAVEL, SILHOUETTE, UNFOLD_DEFAULTS, VIEW} from '../scripts/mark-geometry';

interface Props {
    class?: string;
    drawDelay?: number;
    fillDelay?: number;
    shells?: number;
    depth?: number;
    ladder?: number;
}

const {
    class: className = '',
    drawDelay = 0,
    fillDelay = 900,
    shells = UNFOLD_DEFAULTS.shells,
    depth = UNFOLD_DEFAULTS.depth,
    ladder = 0.13
} = Astro.props;

const clipId = uid('morph-clip');
const bareId = uid('morph-bare');

const INK = inkPoints();
const BARE = barePath(INK_TRAVEL);

const INTRO = fillDelay + 1400;
---

<svg
    class:list={['morphing-mark', className]}
    viewBox={`0 0 ${VIEW} ${VIEW}`}
    role="img"
    aria-label="aerulion logo"
    data-collide="mark"
    data-morphing-mark
    data-intro-delay={INTRO}
    data-shells={shells}
    data-depth={depth}
    data-ladder={ladder}
    style={`--draw-delay:${drawDelay}ms; --fill-delay:${fillDelay}ms; --ink-travel:${INK_TRAVEL}px;`}
>
    <defs>
        <clipPath id={clipId}>
            <path class="mark-clip" d={SILHOUETTE}></path>
        </clipPath>
        <clipPath id={bareId}>
            <path class="mark-bare" clip-rule="evenodd" d={BARE}></path>
        </clipPath>
    </defs>

    <g class="mark-depth" aria-hidden="true">
        <path class="mark-ladder" d="" style={ladder > 0 ? undefined : 'display:none'}></path>
        {Array.from({length: shells * 2}, () => <path class="mark-shell" d="" />)}
    </g>

    <g clip-path={`url(#${bareId})`}>
        <g clip-path={`url(#${clipId})`}>
            <path class="draw-path mark-outline" d={SILHOUETTE} pathLength="1"></path>
        </g>
    </g>

    <g clip-path={`url(#${clipId})`}>
        <polygon class="mark-ink" points={INK}></polygon>
    </g>
</svg>

<style>
    .morphing-mark {
        display: block;
        width: 100%;
        height: auto;
        overflow: visible;
    }

    .mark-outline {
        stroke-width: 0.8;
    }

    .mark-ladder,
    .mark-shell {
        fill: none;
        stroke: var(--white);
        stroke-width: 0.9;
        vector-effect: non-scaling-stroke;
        opacity: 0;
    }

    .mark-shell {
        stroke-linejoin: miter;
    }

    .mark-ink {
        fill: var(--white);
        transform: translateY(var(--ink-travel));
    }

    :global(.js) .mark-ink {
        transition: transform var(--dur-lg) var(--ease-draw) var(--fill-delay, 900ms);
    }

    :global(.is-drawn) .mark-ink,
    :global(html:not(.js)) .mark-ink {
        transform: translateY(0);
    }

    /* Once the loop owns the ink offset, the intro transition must let go. */
    .morphing-mark.is-live .mark-ink {
        transition: none;
    }

    /* Half the stroke sits outside the silhouette, so it goes once inked. */
    :global(.js) .mark-outline {
        transition:
            stroke-dashoffset var(--dur-xl) var(--ease-draw) var(--draw-delay, 0ms),
            stroke-opacity var(--dur-sm) linear calc(var(--fill-delay, 900ms) + 700ms);
    }

    :global(.is-drawn) .mark-outline {
        stroke-opacity: 0;
    }

    /* The stroke is clipped to the silhouette, so it reads as an inner one and shares
       its outer edge with the ink, and to wherever the ink is not, so the sweep itself
       uncovers and re-covers the wireframe with no step between the two. */
    .morphing-mark.is-live .mark-outline {
        stroke-opacity: 1;
        stroke-width: 1.8;
        stroke-dasharray: none;
        stroke-dashoffset: 0;
        transition: none;
    }

    @media (prefers-reduced-motion: reduce) {
        .mark-ink {
            transform: translateY(0);
        }

        .mark-outline {
            stroke-opacity: 0;
        }

        .mark-depth {
            display: none;
        }
    }
</style>
