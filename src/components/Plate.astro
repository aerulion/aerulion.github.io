---
interface Props {
    stations?: number;
}

const {stations = 6} = Astro.props;
const readout = `00 / ${String(stations).padStart(2, '0')}`;
---

<div class="frame" aria-hidden="true">
    <span class="bleed bleed-top" data-collide="none"></span>
    <span class="bleed bleed-bottom" data-collide="none"></span>
    <span class="bleed bleed-left" data-collide="none"></span>
    <span class="bleed bleed-right" data-collide="none"></span>

    <span class="rule rule-top"></span>
    <span class="rule rule-bottom"></span>
    <span class="rule rule-left"></span>
    <span class="rule rule-right"></span>

    <div class="gauge" data-gauge>
        <p class="gauge-readout mono-label" data-gauge-readout>{readout}</p>
        <span class="gauge-tick"></span>
    </div>
</div>

<style>
    .frame {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: var(--layer-plate);
    }

    /* Opaque margin: the crop marks read as a true edge, so nothing scrolls
       past them. The gauge tick sits after these and keeps its overhang. */
    .bleed {
        position: absolute;
        background: var(--black);
    }

    .bleed-top,
    .bleed-bottom {
        left: 0;
        right: 0;
        height: var(--plate-inset);
    }

    .bleed-left,
    .bleed-right {
        top: 0;
        bottom: 0;
        width: var(--plate-inset);
    }

    .bleed-top {
        top: 0;
    }

    .bleed-bottom {
        bottom: 0;
    }

    .bleed-left {
        left: 0;
    }

    .bleed-right {
        right: 0;
    }

    .rule {
        position: absolute;
        background: var(--white);
    }

    .rule-top,
    .rule-bottom {
        left: 0;
        right: 0;
        height: var(--hairline);
    }

    .rule-left,
    .rule-right {
        top: 0;
        bottom: 0;
        width: var(--hairline);
    }

    .rule-top {
        top: var(--plate-inset);
    }

    .rule-bottom {
        bottom: var(--plate-inset);
    }

    .rule-left {
        left: var(--plate-inset);
    }

    .rule-right {
        right: var(--plate-inset);
    }

    .gauge {
        --gauge-inset: clamp(3rem, 7vh, 5rem);

        position: absolute;
        top: calc(var(--plate-inset) + var(--gauge-inset));
        bottom: calc(var(--plate-inset) + var(--gauge-inset));
        right: var(--plate-inset);
        width: 0;
        opacity: 0;
    }

    .gauge[data-live='true'] {
        opacity: 1;
    }

    .gauge-tick {
        position: absolute;
        top: calc(var(--tick, 0) * 100%);
        right: 0;
        width: 17px;
        height: var(--hairline);
        background: var(--white);
        transform: translate(8px, -50%);
    }

    .gauge-readout {
        position: absolute;
        top: calc(var(--tick, 0) * 100%);
        right: 24px;
        transform: translateY(-50%);
        white-space: nowrap;
        color: var(--white);
    }

    @media (max-width: 1799px) {
        .gauge-readout {
            display: none;
        }
    }

    @media (max-width: 640px) {
        .gauge {
            display: none;
        }
    }
</style>
