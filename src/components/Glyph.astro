---
import {GLYPH_BOX, glyphs, type GlyphName} from '../data/glyphs';
import {collide} from '../scripts/figure-collide';

interface Props {
    name: GlyphName;
    class?: string;
}

const {name, class: className} = Astro.props;

const box = `0 0 ${GLYPH_BOX} ${GLYPH_BOX}`;
const strokes = [...glyphs[name]];
---

<svg
    class:list={['glyph', className]}
    viewBox={box}
    aria-hidden="true"
    focusable="false"
    data-collide="lines"
    data-segments={collide(box, strokes)}
>
    {strokes.map((d) => <path d={d} />)}
</svg>

<style>
    .glyph {
        display: block;
        width: 1em;
        height: 1em;
        flex-shrink: 0;
        fill: none;
        stroke: currentColor;
    }

    .glyph path {
        stroke-width: 1;
        vector-effect: non-scaling-stroke;
        stroke-linecap: butt;
        stroke-linejoin: miter;
    }
</style>
