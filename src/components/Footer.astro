---
import {getCurrentYear} from '../utils/dates';
import {commitUrl, repoUrl, shortCommitHash} from '../utils/git';

const currentYear = getCurrentYear();
---

<footer>
    <div class="container">
        <div class="footer-content">
            <p class="footer-mark">aerulion.net</p>
            <p class="footer-line">
                <span>&copy; 2022&ndash;{currentYear}</span>
                <span aria-hidden="true">/</span>
                <a href="/design" class="footer-link">Design</a>
                <span aria-hidden="true">/</span>
                <a href={repoUrl} target="_blank" rel="noopener noreferrer" class="footer-link">Source</a>
                <span aria-hidden="true">/</span>
                <a href={commitUrl} target="_blank" rel="noopener noreferrer" class="footer-link">
                    Build {shortCommitHash}
                </a>
            </p>
        </div>
    </div>
</footer>

<style>
    /* No background: an opaque one reads as a surface to the lattice, which
       then drops every vertex inside the footer. */
    footer {
        position: relative;
        z-index: var(--layer-page);
        padding: var(--spacing-2xl) 0 var(--spacing-xl);
    }

    .footer-content {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: var(--spacing-md);
    }

    .footer-mark {
        font-family: var(--font-family-accent), sans-serif;
        letter-spacing: 0.02em;
    }

    .footer-line {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--spacing-xs);
        font-family: var(--font-family-mono), monospace;
        font-size: var(--label-size);
        letter-spacing: var(--label-tracking);
        text-transform: uppercase;
    }

    .footer-link {
        padding: 0 var(--spacing-3xs);
        text-decoration: none;
        transition:
            background var(--transition-base),
            color var(--transition-base);
    }

    .footer-link:hover,
    .footer-link:focus-visible {
        background: var(--white);
        color: var(--black);
    }

    @media (max-width: 560px) {
        .footer-content {
            justify-content: flex-start;
        }
    }
</style>
