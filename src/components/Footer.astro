---
import {getCurrentYear} from '../utils/dates';
import {commitUrl, repoUrl, shortCommitHash} from "../utils/git.ts";

const currentYear = getCurrentYear();
---

<footer>
    <div class="container">
        <div class="footer-content">
            <p class="footer-mark">aerulion.net</p>
            <p class="footer-line">
                <span>&copy; 2022&ndash;{currentYear}</span>
                <span aria-hidden="true">/</span>
                <a href={repoUrl} target="_blank" rel="noopener noreferrer" class="footer-link">Source</a>
                <span aria-hidden="true">/</span>
                <a href={commitUrl} target="_blank" rel="noopener noreferrer" class="footer-link">
                    Build {shortCommitHash}
                </a>
            </p>
        </div>
    </div>
</footer>

<style>
    footer {
        padding: var(--spacing-2xl) 0 var(--spacing-xl);
        border-top: var(--hairline) solid var(--white);
        background: var(--black);
    }


    .footer-content {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: var(--spacing-md);
    }

    .footer-mark {
        font-family: var(--font-family-accent), sans-serif;
        font-size: var(--font-size-base);
        letter-spacing: 0.02em;
        color: var(--white);
    }

    .footer-line {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.6rem;
        font-family: var(--font-family-mono), monospace;
        font-size: var(--label-size);
        letter-spacing: var(--label-tracking);
        text-transform: uppercase;
        color: var(--white);
    }

    .footer-link {
        color: inherit;
        text-decoration: none;
        transition: color var(--transition-base);
    }

    .footer-link:hover {
        color: var(--white);
    }

    @media (max-width: 560px) {
        .footer-content {
            justify-content: flex-start;
        }
    }
</style>
