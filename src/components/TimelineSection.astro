---
import {FIRST_YEAR, timeline} from '../data/timeline';
import {getCurrentYear} from '../utils/dates';

const years = getCurrentYear() - FIRST_YEAR;
const MARK_STAGGER = 90;
---

<section class="timeline-section" id="timeline" data-station="02 / 06">
    <div class="container">
        <div class="section-header" data-reveal>
            <div class="section-rail">
                <p class="section-eyebrow">Timeline</p>
                <span class="section-rule" aria-hidden="true"></span>
                <p class="section-count" data-roll>02 / 06</p>
            </div>
            <h2 class="section-title">Since before it had a name.</h2>
            <div class="section-lede">
                <p class="section-subtitle">
                    Java came first, the name two years later, Corpium two after that. {years} years on it is still the same
                    work, just steadily larger.
                </p>
                <div class="section-line" aria-hidden="true"></div>
            </div>
        </div>

        <ol class="timeline" role="list" data-reveal>
            {
                timeline.map((milestone, index) => {
                    const isNow = index === timeline.length - 1;
                    return (
                        <li class="milestone" style={`--node-delay:${index * MARK_STAGGER}ms`}>
                            <p class="milestone-year">{milestone.year}</p>
                            <span class="milestone-mark" aria-hidden="true">
                                <span class="node-line" />
                                <span class:list={['node', isNow && 'node-now']}>
                                    {isNow && <span class="node-face" />}
                                </span>
                            </span>
                            <div class="milestone-body">
                                <h3 class="milestone-title">{milestone.title}</h3>
                                <p class="milestone-note">{milestone.note}</p>
                            </div>
                            <p class="milestone-track">{milestone.track}</p>
                        </li>
                    );
                })
            }
        </ol>
    </div>
</section>

<style>
    .timeline-section {
        padding-bottom: var(--spacing-5xl);
    }

    .timeline {
        list-style: none;
    }

    .milestone {
        display: grid;
        grid-template-columns: 4.5rem 1rem minmax(0, 34rem) minmax(0, 1fr);
        column-gap: var(--flow-xl);
    }

    .milestone-year {
        font-family: var(--font-family-mono), monospace;
        font-size: var(--label-size);
        letter-spacing: var(--label-tracking);
        text-transform: uppercase;
        text-align: right;
        padding-top: var(--spacing-3xs);
    }

    .milestone-mark {
        position: relative;
        display: block;
    }

    .node-line {
        position: absolute;
        top: 0;
        bottom: 0;
        left: 50%;
        width: var(--hairline);
        background: var(--white);
    }

    .node {
        position: absolute;
        left: 0;
        right: 0;
        top: var(--spacing-sm);
        height: var(--hairline);
        background: var(--white);
    }

    .node-now {
        top: var(--spacing-xs);
        left: 50%;
        right: auto;
        width: 0.5rem;
        height: 0.5rem;
        background: transparent;
        transform: translateX(-50%);
    }

    .node-face {
        position: absolute;
        inset: 0;
        background: var(--white);
        animation: nodeSnap 7s steps(1, end) infinite;
    }

    .milestone-body {
        padding-bottom: var(--flow-2xl);
    }

    .milestone:last-child .milestone-body {
        padding-bottom: 0;
    }

    .milestone-title {
        font-family: var(--font-family-display), sans-serif;
        font-size: clamp(1.15rem, 1.9vw, 1.6rem);
        font-weight: 600;
        line-height: 1;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .milestone-note {
        padding-top: var(--spacing-xs);
    }

    .milestone-track {
        font-family: var(--font-family-mono), monospace;
        font-size: var(--label-size);
        letter-spacing: var(--label-tracking);
        text-transform: uppercase;
        text-align: right;
        padding-top: var(--spacing-3xs);
    }

    @media (max-width: 1100px) {
        .milestone {
            grid-template-columns: 4.5rem 1rem minmax(0, 1fr) auto;
        }
    }

    @media (max-width: 768px) {
        .milestone-track {
            display: none;
        }
    }

    @media (max-width: 560px) {
        .milestone {
            grid-template-columns: 3.5rem 0.75rem minmax(0, 1fr) auto;
            column-gap: var(--spacing-sm);
        }

        .milestone-note {
            font-size: var(--font-size-sm);
        }
    }
</style>
