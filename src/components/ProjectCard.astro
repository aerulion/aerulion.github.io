---
import type {Project} from '../data/projects';

interface Props {
    project: Project;
    position: number;
}

const {project, position} = Astro.props;
const {title, tagline, description, iconUrl, meta, capabilities} = project;
const index = String(position).padStart(2, '0');
---

<article class="project-card panel-cut" data-reveal>
    <div class="project-topline">
        <span class="project-index">{index}</span>
        <span class="project-rule" aria-hidden="true"></span>
        <span class="project-kind">System</span>
    </div>

    <div class="project-head">
        <div class="project-icon">
            <img src={iconUrl} alt="" aria-hidden="true" width="48" height="48" loading="lazy" />
        </div>
        <div class="project-heading">
            <h3 class="project-title">{title}</h3>
            <p class="project-tagline">{tagline}</p>
        </div>
    </div>

    <dl class="project-meta">
        {
            meta.map((item) => (
                <div class="meta-row">
                    <dt>{item.label}</dt>
                    <dd>{item.value}</dd>
                </div>
            ))
        }
    </dl>

    <div class="project-content prose">
        {description.map((paragraph) => <p class="project-description">{paragraph}</p>)}
    </div>

    <div class="project-capabilities">
        <p class="capabilities-label">Surface</p>
        <ul class="capability-list" role="list">
            {capabilities.map((capability) => <li>{capability}</li>)}
        </ul>
    </div>
</article>

<style>
    /* Bands inherited from the grid, so both cards break at the same heights. */
    .project-card {
        grid-row: span 5;
        display: grid;
        grid-template-rows: subgrid;
        padding: var(--flow-2xl);
    }

    .project-topline {
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: var(--spacing-sm);
    }

    .project-index {
        font-family: var(--font-family-mono), monospace;
        font-size: var(--font-size-sm);
        letter-spacing: 0.16em;
    }

    .project-kind {
        font-family: var(--font-family-mono), monospace;
        font-size: var(--label-size);
        letter-spacing: var(--label-tracking);
        text-transform: uppercase;
    }

    .project-rule {
        display: block;
        height: var(--hairline);
        background: var(--white);
    }

    .project-head {
        display: flex;
        align-items: center;
        gap: var(--spacing-lg);
    }

    .project-icon {
        width: 72px;
        height: 72px;
        display: grid;
        place-items: center;
        border: var(--hairline) solid var(--white);
        background: var(--black);
        flex-shrink: 0;
    }

    .project-icon img {
        width: 42px;
        height: 42px;
    }

    .project-heading {
        display: grid;
        gap: var(--spacing-2xs);
        min-width: 0;
    }

    .project-title {
        font-family: var(--font-family-display), sans-serif;
        font-size: clamp(1.75rem, 2.6vw, var(--font-size-3xl));
        font-weight: 600;
        line-height: 0.96;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .project-tagline {
        font-size: var(--font-size-sm);
        text-wrap: balance;
    }

    .project-meta {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        border: var(--hairline) solid var(--white);
    }

    .meta-row {
        display: grid;
        align-content: start;
        gap: var(--spacing-2xs);
        padding: var(--spacing-sm) var(--spacing-md);
    }

    .meta-row + .meta-row {
        border-left: var(--hairline) solid var(--white);
    }

    .meta-row dt {
        font-family: var(--font-family-mono), monospace;
        font-size: var(--label-size);
        letter-spacing: 0.16em;
        text-transform: uppercase;
    }

    .meta-row dd {
        font-size: var(--font-size-sm);
        line-height: 1.4;
    }

    .project-content {
        display: grid;
        gap: var(--spacing-md);
        align-content: start;
    }

    .project-description {
        line-height: 1.8;
        max-width: 62ch;
    }

    .project-capabilities {
        display: grid;
        gap: var(--spacing-sm);
        align-content: end;
        padding-top: var(--spacing-lg);
        border-top: var(--hairline) solid var(--white);
    }

    .capabilities-label {
        font-family: var(--font-family-mono), monospace;
        font-size: var(--label-size);
        letter-spacing: var(--label-tracking);
        text-transform: uppercase;
    }

    .capability-list {
        display: flex;
        flex-wrap: wrap;
        gap: var(--spacing-2xs);
        list-style: none;
    }

    .capability-list li {
        padding: var(--spacing-2xs) var(--spacing-sm);
        border: var(--hairline) solid var(--white);
        font-family: var(--font-family-mono), monospace;
        font-size: var(--label-size);
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }

    @media (max-width: 560px) {
        .project-head {
            align-items: flex-start;
            flex-direction: column;
        }

        .project-meta {
            grid-template-columns: 1fr;
        }

        .meta-row + .meta-row {
            border-left: 0;
            border-top: var(--hairline) solid var(--white);
        }
    }
</style>
