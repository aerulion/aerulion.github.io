---
import {stack} from '../data/stack';
---

<section class="stack-section" id="stack">
    <div class="container">
        <div class="section-header" data-reveal>
            <div class="section-rail">
                <p class="section-eyebrow">Stack</p>
                <span class="section-rule" aria-hidden="true"></span>
                <p class="section-count">04 / 05</p>
            </div>
            <h2 class="section-title">A short, deliberate list.</h2>
            <div class="section-lede">
                <p class="section-subtitle">
                    Nothing here was picked for novelty. These are the tools I know deeply enough to keep predictable
                    under load, and I keep them for years.
                </p>
                <div class="section-line" aria-hidden="true"></div>
            </div>
        </div>

        <dl class="stack-grid" data-reveal>
            {stack.map((group) => (
                    <div class="stack-cell">
                        <dt class="stack-label">{group.label}</dt>
                        <dd class="stack-items">
                            <ul role="list">
                                {group.items.map((item) =>
                                        <li>{item}</li>)}
                            </ul>
                        </dd>
                    </div>
            ))}
        </dl>
    </div>
</section>

<style>
    .stack-section {
        padding-bottom: var(--spacing-5xl);
    }

    .stack-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        border: var(--hairline) solid var(--white);
    }

    .stack-cell {
        display: grid;
        align-content: start;
        gap: var(--spacing-lg);
        padding: clamp(1.25rem, 2.5vw, 2rem);
    }

    .stack-cell + .stack-cell {
        border-left: var(--hairline) solid var(--white);
    }

    .stack-label {
        font-family: var(--font-family-mono), monospace;
        font-size: var(--label-size);
        letter-spacing: var(--label-tracking);
        text-transform: uppercase;
    }

    .stack-items ul {
        display: grid;
        gap: 0.45rem;
        list-style: none;
    }

    .stack-items li {
        font-size: clamp(1rem, 1.25vw, var(--font-size-lg));
        letter-spacing: 0.01em;
        line-height: 1.3;
    }

    @media (max-width: 900px) {
        .stack-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .stack-cell + .stack-cell {
            border-left: 0;
        }

        .stack-cell:nth-child(even) {
            border-left: var(--hairline) solid var(--white);
        }

        .stack-cell:nth-child(n + 3) {
            border-top: var(--hairline) solid var(--white);
        }
    }

    @media (max-width: 480px) {
        .stack-grid {
            grid-template-columns: 1fr;
        }

        .stack-cell:nth-child(even) {
            border-left: 0;
        }

        .stack-cell + .stack-cell {
            border-top: var(--hairline) solid var(--white);
        }
    }
</style>
