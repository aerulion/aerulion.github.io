---
import {Font} from 'astro:assets';
import '../styles/global.css';

interface Props {
    title: string;
    description: string;
    noindex?: boolean;
}

const {title, description, noindex = false} = Astro.props;

const site = Astro.site ?? new URL('https://aerulion.net');
const canonical = new URL(Astro.url.pathname, site);
const socialImage = new URL('/assets/images/og.png', site);
const socialImageAlt = 'aerulion — Java developer and Minecraft plugin creator';

const person = {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'aerulion',
    jobTitle: 'Java Developer & Minecraft Plugin Creator',
    description: 'Java developer specializing in Minecraft plugin development and custom server systems',
    url: site.href,
    image: socialImage.href,
    knowsAbout: [
        'Java Development',
        'Minecraft Plugin Development',
        'Paper API',
        'Bukkit API',
        'Database Design',
        'Game Development'
    ],
    worksFor: {'@type': 'Organization', name: 'Corpium', url: 'https://corpium.net'},
    nationality: {'@type': 'Country', name: 'Germany'},
    sameAs: ['https://github.com/aerulion']
};
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="author" content="aerulion" />
        <meta name="theme-color" content="#000000" />
        {
            noindex ? (
                <meta name="robots" content="noindex, follow" />
            ) : (
                <>
                    <meta name="robots" content="index, follow, max-image-preview:large" />
                    <link rel="canonical" href={canonical} />
                </>
            )
        }

        <Font cssVariable="--font-family" preload />
        <Font cssVariable="--font-family-accent" preload />
        <Font cssVariable="--font-family-display" preload />
        <Font cssVariable="--font-family-mono" preload />

        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="aerulion" />
        <meta property="og:locale" content="en_US" />
        <meta property="og:url" content={canonical} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={socialImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={socialImageAlt} />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={socialImage} />
        <meta name="twitter:image:alt" content={socialImageAlt} />

        <script type="application/ld+json" is:inline set:html={JSON.stringify(person)} />

        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
        <link rel="manifest" href="/site.webmanifest" />

        <!-- Set before paint so reveal targets start hidden. The timeout is a
         dead-man's switch: without it a failed module hides the page. -->
        <script is:inline>
            document.documentElement.classList.add('js');
            setTimeout(function () {
                const root = document.documentElement;
                if (!root.classList.contains('motion-ready')) root.classList.remove('js');
            }, 4000);
        </script>
    </head>
    <body>
        <slot />

        <script>
            import {mountReveals} from '../scripts/reveal';
            import {mountMorphingLogoMarks} from '../scripts/morphing-logo-mark';

            mountReveals();
            mountMorphingLogoMarks();
        </script>
    </body>
</html>
