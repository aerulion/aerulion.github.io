---
interface Props {
    title: string;
    description: string;
}

const {title, description} = Astro.props;
import {Font} from 'astro:assets';
import '../styles/global.css';

const structuredData = {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "aerulion",
    "jobTitle": "Java Developer & Minecraft Plugin Creator",
    "description": "Professional Java developer specializing in Minecraft plugin development and custom server systems",
    "url": "https://aerulion.net",
    "image": "https://aerulion.net/assets/images/aerulion.webp",
    "knowsAbout": ["Java Development", "Minecraft Plugin Development", "Paper API", "Bukkit API", "Database Design", "Game Development"],
    "worksFor": {"@type": "Organization", "name": "Corpium", "url": "https://corpium.net"},
    "nationality": {"@type": "Country", "name": "Germany"},
    "sameAs": ["https://github.com/aerulion"]
}
---

<Font cssVariable="--font-family" preload/>
<Font cssVariable="--font-family-accent" preload/>
<Font cssVariable="--font-family-display" preload/>
<Font cssVariable="--font-family-mono" preload/>

<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta name="keywords"
          content="Java developer, Minecraft plugins, Paper development, Bukkit, custom server development, Minecraft programming, game development, aerulion">
    <meta name="author" content="aerulion">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://aerulion.net/">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content="https://aerulion.net/assets/images/aerulion.webp">
    <meta property="og:locale" content="en_US">
    <meta property="og:site_name" content="aerulion">

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content="https://aerulion.net/">
    <meta property="twitter:title" content={title}>
    <meta property="twitter:description" content={description}>
    <meta property="twitter:image" content="https://aerulion.net/assets/images/aerulion.webp">

    <!-- Additional SEO -->
    <meta name="robots" content="index, follow">
    <meta name="googlebot" content="index, follow">
    <link rel="canonical" href="https://aerulion.net/">

    <!-- Structured Data -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)}/>

    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">

    <!-- Set before paint so reveal targets start hidden without flashing.
         The timeout is a dead-man's switch: if the module never runs, the
         class is dropped so content cannot stay invisible. -->
    <script is:inline>
        document.documentElement.classList.add('js');
        setTimeout(function () {
            var root = document.documentElement;
            if (!root.classList.contains('motion-ready')) root.classList.remove('js');
        }, 4000);
    </script>
</head>
<body>
<slot/>

<script>
    document.documentElement.classList.add('motion-ready');

    const reveals = document.querySelectorAll<HTMLElement>('[data-reveal]');
    const draws = document.querySelectorAll<HTMLElement>('[data-draw]');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const canObserve = 'IntersectionObserver' in window;

    if (prefersReducedMotion || !canObserve) {
        reveals.forEach((el) => el.classList.add('is-revealed'));
        draws.forEach((el) => el.classList.add('is-drawn'));
    } else {
        const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                entry.target.classList.add(
                    entry.target.hasAttribute('data-draw') ? 'is-drawn' : 'is-revealed'
                );
                observer.unobserve(entry.target);
            });
        }, {rootMargin: '0px 0px -10% 0px', threshold: 0.05});

        reveals.forEach((el, index) => {
            el.style.setProperty('--reveal-delay', `${Math.min(index, 3) * 80}ms`);
            observer.observe(el);
        });
        draws.forEach((el) => observer.observe(el));
    }
</script>
</body>
</html>